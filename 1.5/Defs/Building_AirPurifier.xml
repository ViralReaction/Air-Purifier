<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>VR_AirPurifier</defName>
		<label>air purifier</label>
		<description>A device that filters and cleans the air, removing contaminants like smoke. Automatically adjusts to keep air quality at optimal levels.</description>
		<thingClass>AirPurifier.Building_AirPurifier</thingClass>
		<graphicData>
			<texPath>Things/Building/Misc/AirPurifier/AirPurifier</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
			<shadowData>
				<volume>(0.5,0.5,0.7)</volume>
			</shadowData>
			<damageData>
				<rect>(0.234375,0,0.515625,0.984375)</rect>
			</damageData>
		</graphicData>
		<minifiedDef>MinifiedThing</minifiedDef>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>30</pathCost>
		<blockWind>true</blockWind>
		<rotatable>true</rotatable>
		<fillPercent>0.4</fillPercent>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<statBases>
			<WorkToBuild>1000</WorkToBuild>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>6</Mass>
			<Flammability>0.5</Flammability>
			<Cleanliness>5</Cleanliness>
		</statBases>
		<tickerType>Normal</tickerType>
		<building>
			<destroySound>BuildingDestroyed_Metal_Small</destroySound>
		</building>
		<costList>
			<Steel>20</Steel>
			<Chemfuel>30</Chemfuel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<placeWorkers>
			<li>AirPurifier.PlaceWorker_AirPurifier</li>
		</placeWorkers>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
				<shortCircuitInRain>true</shortCircuitInRain>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Breakdownable"/>
			<li Class="CompProperties_Refuelable">
				<fuelCapacity>20</fuelCapacity>
				<fuelFilter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</fuelFilter>
				<fuelConsumptionRate>0.67</fuelConsumptionRate>
				<consumeFuelOnlyWhenUsed>false</consumeFuelOnlyWhenUsed>
				<showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
			</li>
		</comps>
		<modExtensions>
			<li Class="AirPurifier.SmokeConsumptionExtension">
				<consumptionRate>0.015</consumptionRate>
			</li>
		</modExtensions>
		<designationCategory>Misc</designationCategory>
		<designationHotKey>Misc2</designationHotKey>
		<researchPrerequisites>
			<li>AirConditioning</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
	</ThingDef>

</Defs>